<UserControl
    x:Class="WinIRC.WinUI.Views.ConnectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinIRC.Core.Models"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar DefaultLabelPosition="Right">
            <AppBarButton Icon="Add" Label="New" Click="NewServer_Click" />
            <AppBarButton Icon="Save" Label="Save" Click="SaveServer_Click" />
            <AppBarButton x:Name="DeleteServerButton" Icon="Delete" Label="Delete" Click="DeleteServer_Click" />
            <AppBarSeparator />
            <AppBarButton Icon="OpenFile" Label="Open Session" Click="OpenSession_Click" />
        </CommandBar>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="20" Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Connect" Style="{ThemeResource TitleLargeTextBlockStyle}" />
                    <TextBlock
                        Opacity="0.72"
                        Text="Add, edit, delete, and reopen saved networks from here."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <ComboBox
                    x:Name="SavedServersCombo"
                    Header="Saved networks"
                    ItemsSource="{x:Bind SavedServers}"
                    PlaceholderText="No saved network selected"
                    SelectionChanged="SavedServersCombo_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:SavedServer">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Name}" />
                                <TextBlock FontSize="12" Opacity="0.72" Text="{x:Bind DisplayEndpoint}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <InfoBar
                    x:Name="WebSocketInfoBar"
                    IsClosable="False"
                    IsOpen="False"
                    Message="WebSocket mode still assumes an IRC forwarder in front of the server, just like the UWP app did."
                    Severity="Informational" />

                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ValidationMessage, Mode=OneWay}"
                    TextWrapping="WrapWholeWords"
                    Visibility="{x:Bind ValidationVisibility, Mode=OneWay}" />

                <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock FontWeight="SemiBold" Text="Connection Details" />
                        <TextBox x:Name="ServerNameTextBox" Header="Saved name" PlaceholderText="Server name" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="HostnameTextBox" Header="Hostname or IP" PlaceholderText="irc.example.net" />
                            <TextBox
                                x:Name="PortTextBox"
                                Grid.Column="1"
                                Header="Port"
                                InputScope="Number"
                                PlaceholderText="6667" />
                        </Grid>

                        <PasswordBox x:Name="ServerPasswordBox" Header="Server password" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ToggleSwitch x:Name="SslToggle" Header="Secure connection" OnContent="Yes" OffContent="No" />
                            <ToggleSwitch
                                x:Name="WebSocketToggle"
                                Grid.Column="1"
                                Header="Connection type"
                                OffContent="Standard"
                                OnContent="WebSocket"
                                Toggled="WebSocketToggle_Toggled" />
                        </Grid>

                        <ToggleSwitch
                            x:Name="AutoConnectToggle"
                            Header="Connect on startup"
                            OffContent="No"
                            OnContent="Yes" />
                    </StackPanel>
                </Border>

                <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock FontWeight="SemiBold" Text="User Info" />
                        <TextBox x:Name="UsernameTextBox" Header="Username" PlaceholderText="nickname" />
                        <PasswordBox x:Name="NickservPasswordBox" Header="NickServ password" />
                        <TextBox x:Name="ChannelsTextBox" Header="Channels to join" PlaceholderText="#winirc,#dotnet" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
