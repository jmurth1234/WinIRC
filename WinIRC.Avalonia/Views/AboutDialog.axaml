<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WinIRC.Avalonia.AboutDialog"
        Title="About WinIRC"
        Width="420"
        Height="320"
        MinWidth="360"
        MinHeight="280"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,18,0,0">
            <Button Content="Website" Click="Website_Click" />
            <Button Content="GitHub" Click="GitHub_Click" />
            <Button Content="Join Support" Click="JoinSupport_Click" />
            <Button Content="Close" Click="Close_Click" />
        </StackPanel>

        <StackPanel Spacing="12">
            <TextBlock x:Name="VersionText" Text="WinIRC" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="A cross-platform IRC client for Linux, Windows, and macOS."
                       TextWrapping="Wrap" />
            <TextBlock Text="Support channel: #WinIRC on Libera"
                       TextWrapping="Wrap" />
            <TextBlock Text="Project issue tracker: github.com/rymate1234/WinIRC/issues"
                       TextWrapping="Wrap"
                       Opacity="0.75" />
        </StackPanel>
    </DockPanel>
</Window>
