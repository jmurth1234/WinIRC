<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WinIRC.Avalonia.PasteTextDialog"
        Title="Paste Text"
        Width="560"
        Height="420"
        MinWidth="420"
        MinHeight="300"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Spacing="8">
            <TextBlock Text="The pasted text contains multiple lines." FontWeight="SemiBold" />
            <TextBlock Text="Upload it and insert the returned link, or insert the text as one line." TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="Upload" Click="Upload_Click" />
            <Button Content="Insert Text" Click="Insert_Click" />
            <Button Content="Cancel" Click="Cancel_Click" />
        </StackPanel>

        <TextBox x:Name="PasteBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Margin="0,16,0,0" />
    </DockPanel>
</Window>
